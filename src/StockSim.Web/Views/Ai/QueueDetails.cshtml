@model StockSim.Application.Dtos.AiQueueItemDetailDto
@using StockSim.Domain.Enums
@using StockSim.Web.Helpers
@{
    string TypeName(AiQueueTaskType t) => t switch
    {
        AiQueueTaskType.GoalToPrompt => "目标→提示词",
        AiQueueTaskType.StockPick => "选股",
        AiQueueTaskType.StrategyRefresh => "策略刷新",
        AiQueueTaskType.DownsideRiskPredict => "预测风险",
        AiQueueTaskType.DailyTReview => "每日复盘",
        _ => t.ToString()
    };
    string StatusName(AiQueueItemStatus s) => s switch
    {
        AiQueueItemStatus.Pending => "排队中",
        AiQueueItemStatus.Running => "执行中",
        AiQueueItemStatus.Succeeded => "成功",
        AiQueueItemStatus.Failed => "失败",
        _ => s.ToString()
    };
    var badge = Model.Status switch
    {
        AiQueueItemStatus.Pending => "secondary",
        AiQueueItemStatus.Running => "primary",
        AiQueueItemStatus.Succeeded => "success",
        AiQueueItemStatus.Failed => "danger",
        _ => "dark"
    };
    var jobLinkText = Model.TaskType == AiQueueTaskType.StrategyRefresh ? "策略 Job" : "选股 Job";
}
<div class="mb-3 d-flex justify-content-between align-items-start flex-wrap gap-2">
    <div>
        <h2 class="mb-1">@Model.Title</h2>
        <span class="badge bg-@badge">@StatusName(Model.Status)</span>
        <span class="text-muted small ms-2">@TypeName(Model.TaskType)</span>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary btn-sm" asp-action="Queue">返回队列</a>
        @if (Model.RelatedAiJobId.HasValue)
        {
            <a class="btn btn-outline-primary btn-sm" asp-action="Details" asp-route-id="@Model.RelatedAiJobId" asp-route-goalId="@Model.RelatedGoalId">@jobLinkText</a>
        }
        @if (Model.RelatedGoalId.HasValue)
        {
            <a class="btn btn-outline-primary btn-sm" asp-action="GoalDetails" asp-route-id="@Model.RelatedGoalId">投资目标</a>
        }
    </div>
</div>

<table class="table table-sm mb-3">
    <tr><th style="width:8rem">标的</th><td>@(Model.Symbol ?? "—")</td></tr>
    <tr><th>关联</th><td class="small text-muted">
        目标 @(Model.RelatedGoalId?.ToString() ?? "—") ·
        Job @(Model.RelatedAiJobId?.ToString() ?? "—") ·
        池成分 @(Model.RelatedPoolItemId?.ToString() ?? "—") ·
        关联号 @(Model.CorrelationId?.ToString() ?? "—")
    </td></tr>
    <tr><th>入队</th><td>@Model.CreationTime.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td></tr>
    <tr><th>开始</th><td>@(Model.StartedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? "—")</td></tr>
    <tr><th>结束</th><td>@(Model.CompletedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? "—")</td></tr>
    <tr><th>Worker</th><td class="small">@(Model.WorkerId ?? "—")</td></tr>
</table>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger"><strong>错误：</strong>@Model.ErrorMessage</div>
}

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>输入</span>
        <span class="text-muted small fw-normal">字段名已尽量中文化，仅用于展示</span>
    </div>
    <div class="card-body">
        <pre class="mb-0 small" style="white-space:pre-wrap;max-height:420px;overflow:auto;">@AiPayloadChineseDisplay.Format(Model.InputPayload)</pre>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>返回结果</span>
        <span class="text-muted small fw-normal">字段名已尽量中文化，仅用于展示</span>
    </div>
    <div class="card-body">
        <pre class="mb-0 small" style="white-space:pre-wrap;max-height:480px;overflow:auto;">@(string.IsNullOrWhiteSpace(Model.OutputPayload) ? "（尚未产出或为空）" : AiPayloadChineseDisplay.Format(Model.OutputPayload))</pre>
    </div>
</div>
