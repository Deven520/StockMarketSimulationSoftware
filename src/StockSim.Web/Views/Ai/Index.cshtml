@model StockSim.Web.Models.PagedResult<StockSim.Application.Dtos.AiJobDto>
@using StockSim.Domain.Enums
@using StockSim.Application.Services
@using StockSim.Application.Dtos
@{
    var cursorStatus = ViewBag.CursorStatus as CursorAiConnectionStatus;
    var goals = (IReadOnlyList<InvestmentGoalDto>)(ViewBag.Goals ?? Array.Empty<InvestmentGoalDto>());
    var themeCat = ViewBag.ThemeCatalog as NextDayThemeComposerCatalogDto;
}
<h2>AI 工作台</h2>
<p class="text-muted">输入<strong>预期收益、周期、题材偏好、选股类型</strong>（含次日上涨预选）→ 任务进入 <a asp-action="Queue">AI 队列</a> 异步执行 → 完成后勾选入库；每日跟踪达成率；次日预选在目标日收盘后统计命中率。</p>
@{
    var qc = ViewBag.QueueCounts as (int Pending, int Running, int Succeeded, int Failed)?;
}
@if (qc is not null)
{
    <div class="mb-3 small">
        队列：排队 @qc.Value.Pending · 执行中 @qc.Value.Running ·
        <a asp-action="Queue">查看 AI 队列</a>
    </div>
}
@if (cursorStatus is not null)
{
    <div class="alert @(cursorStatus.Ok ? "alert-success" : "alert-warning") py-2">
        <strong>Cursor Agent：</strong>
        @(cursorStatus.Ok ? "已接通" : "未接通")
        <span class="text-muted">(@cursorStatus.Status)</span>
        @if (!string.IsNullOrWhiteSpace(cursorStatus.Email))
        {
            <span>· @cursorStatus.Email</span>
        }
        <div class="small mt-1">@cursorStatus.Hint</div>
    </div>
}

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">按目标 AI 选股</h5>
        <form asp-action="CreateGoal" method="post" class="row g-3" id="goalForm">
            <div class="col-md-3">
                <label class="form-label">预期收益 (%)</label>
                <input id="expectedReturnPct" name="expectedReturnPct" type="number" step="0.1" min="0.1" class="form-control" value="3" required />
                <div class="form-text" id="expectedHint">次日预涨将钳制为 0.5%～3%（默认 2%）</div>
            </div>
            <div class="col-md-3">
                <label class="form-label">预期周期（天）</label>
                <input id="horizonDays" name="horizonDays" type="number" min="1" class="form-control" value="10" required />
            </div>
            <div class="col-md-6" id="themeFreeWrap">
                <label class="form-label">题材偏好</label>
                <input id="themePreference" name="themePreference" class="form-control" placeholder="例如：新能源、低估值银行、高股息" required />
            </div>

            <div class="col-12 d-none" id="themeComposerWrap">
                <label class="form-label">题材（结构化：板块 + 风格 + 催化）</label>
                @if (themeCat is not null && !string.IsNullOrWhiteSpace(themeCat.MarketNote))
                {
                    <div class="form-text mb-2 @(themeCat.WeakOrDragHeavy ? "text-warning" : "")">@themeCat.MarketNote</div>
                }
                @if (themeCat?.RecommendedChips is { Count: > 0 })
                {
                    <div class="mb-2">
                        <span class="small text-muted me-1">推荐：</span>
                        @foreach (var c in themeCat.RecommendedChips)
                        {
                            var rate = c.DirectionHitRatePct.HasValue
                                ? $"{c.DirectionHitRatePct:0.#}%({c.SampleSize})"
                                : "模板";
                            <button type="button" class="btn btn-sm btn-outline-success me-1 mb-1 theme-chip"
                                    data-theme="@c.Theme" title="@rate">@c.Theme <span class="text-muted">@rate</span></button>
                        }
                    </div>
                }
                @if (themeCat?.CautionChips is { Count: > 0 })
                {
                    <div class="mb-2">
                        <span class="small text-muted me-1">慎用：</span>
                        @foreach (var c in themeCat.CautionChips.Take(5))
                        {
                            var rate = c.DirectionHitRatePct.HasValue
                                ? $"{c.DirectionHitRatePct:0.#}%({c.SampleSize})"
                                : "低";
                            <span class="badge text-bg-light border me-1 mb-1 text-muted" title="历史命中 @rate">@c.Theme @rate</span>
                        }
                    </div>
                }
                @if (themeCat?.DownweightThemes is { Count: > 0 })
                {
                    <div class="mb-2 small text-warning">今日降权：@string.Join("、", themeCat.DownweightThemes)</div>
                }
                <div class="row g-2">
                    <div class="col-md-4">
                        <select id="themeSector" name="themeSector" class="form-select">
                            <option value="">板块（可选/部分风格必填）</option>
                            @if (themeCat is not null)
                            {
                                foreach (var s in themeCat.Sectors)
                                {
                                    <option value="@s">@s</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <select id="themeStyle" name="themeStyle" class="form-select">
                            <option value="">风格</option>
                            @if (themeCat is not null)
                            {
                                foreach (var s in themeCat.Styles)
                                {
                                    if (s.Disabled)
                                    {
                                        <option value="@s.Id" disabled
                                                data-phrase="@s.Phrase" data-requires-sector="@s.RequiresSector.ToString().ToLowerInvariant()">
                                            @(s.Recommended ? "★ " : "")@s.Label@(s.HighRisk ? " ⚠" : "")（弱市禁用）
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@s.Id"
                                                data-phrase="@s.Phrase" data-requires-sector="@s.RequiresSector.ToString().ToLowerInvariant()">
                                            @(s.Recommended ? "★ " : "")@s.Label@(s.HighRisk ? " ⚠" : "")
                                        </option>
                                    }
                                }
                            }
                            else
                            {
                                <option value="oversold">★ 超跌反弹</option>
                                <option value="volume">★ 持续放量</option>
                                <option value="stabilize">★ 低位企稳</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <select id="themeCatalyst" name="themeCatalyst" class="form-select">
                            @if (themeCat is not null)
                            {
                                foreach (var c in themeCat.Catalysts)
                                {
                                    if (c == "无")
                                    {
                                        <option value="@c" selected>催化：@c</option>
                                    }
                                    else
                                    {
                                        <option value="@c">催化：@c</option>
                                    }
                                }
                            }
                            else
                            {
                                <option value="无" selected>催化：无</option>
                                <option value="订单">催化：订单</option>
                                <option value="政策">催化：政策</option>
                                <option value="业绩">催化：业绩</option>
                                <option value="放量">催化：放量</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="mt-2">
                    <label class="form-label small mb-1">预览 / 高级自定义</label>
                    <input id="themePreferenceNext" class="form-control" placeholder="点芯片或三块选择后自动填充；也可手改" />
                    <input type="hidden" id="themePreferenceHidden" name="themePreference" value="" disabled />
                </div>
                <div class="form-check mt-2">
                    <input class="form-check-input" type="checkbox" name="acceptThemeRewrite" value="true" id="acceptThemeRewrite" />
                    <label class="form-check-label small" for="acceptThemeRewrite">空心口号时接受自动改写为「超跌反弹」</label>
                </div>
                <div class="form-text" id="themeComposeHint">公式：板块 + 风格（如「半导体超跌反弹」）；避免单独「有利好 / 有重大利好」。</div>
            </div>

            <div class="col-12">
                <label class="form-label d-block">选股类型</label>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="tradeStyle" id="styleT" value="IntradayT" checked />
                    <label class="form-check-label" for="styleT">做T股（日内高抛低吸）</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="tradeStyle" id="styleTrend" value="TrendSwing" />
                    <label class="form-check-label" for="styleTrend">趋势股（底部/中期趋势观察，不做自动做T）</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="tradeStyle" id="styleNextDay" value="NextDayRise" />
                    <label class="form-check-label" for="styleNextDay">次日上涨预选（方向+相对强弱为主 KPI）</label>
                </div>
            </div>
            <div class="col-12">
                <button class="btn btn-primary">提交选股任务（异步）</button>
                <a class="btn btn-outline-secondary" asp-action="Queue">AI 队列</a>
                <a class="btn btn-outline-secondary" asp-action="Goals">查看目标达成率</a>
            </div>
        </form>
        <form asp-action="EnqueueNextDayPickReviews" method="post" class="mt-2"
              onsubmit="return confirm('为近两周已结算的次日预涨标的入队复盘？');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-info btn-sm"
                    title="扫近两周池/目标已结算记录；结算后自动也会入队">复盘近批次日预涨</button>
        </form>
    </div>
</div>
<script>
(function () {
    const exp = document.getElementById('expectedReturnPct');
    const hor = document.getElementById('horizonDays');
    const hint = document.getElementById('expectedHint');
    const freeWrap = document.getElementById('themeFreeWrap');
    const composerWrap = document.getElementById('themeComposerWrap');
    const freeInput = document.getElementById('themePreference');
    const nextInput = document.getElementById('themePreferenceNext');
    const hiddenInput = document.getElementById('themePreferenceHidden');
    const sectorEl = document.getElementById('themeSector');
    const styleEl = document.getElementById('themeStyle');
    const catalystEl = document.getElementById('themeCatalyst');

    function composePreview() {
        if (!nextInput) return;
        const sector = (sectorEl?.value || '').trim();
        const opt = styleEl?.selectedOptions?.[0];
        const phrase = (opt?.dataset?.phrase || '').trim();
        const cat = (catalystEl?.value || '').trim();
        const parts = [];
        if (sector && phrase) {
            let s = sector + phrase;
            if (cat && cat !== '无' && phrase.indexOf(cat) < 0) s += '+' + cat;
            nextInput.value = s;
            return;
        }
        if (phrase) { nextInput.value = phrase; return; }
        if (sector) { nextInput.value = sector; return; }
    }

    function sync() {
        const next = document.getElementById('styleNextDay')?.checked;
        if (!exp || !hor) return;
        if (next) {
            exp.min = '0.5'; exp.max = '3'; exp.step = '0.1';
            if (parseFloat(exp.value) > 3) exp.value = '2';
            if (parseFloat(exp.value) < 0.5) exp.value = '2';
            if (!exp.dataset.touched) exp.value = '2';
            hor.value = '1'; hor.readOnly = true;
            if (hint) hint.textContent = '次日预涨：预期钳制 0.5%～3%，主看方向命中与相对强弱';
            freeWrap?.classList.add('d-none');
            composerWrap?.classList.remove('d-none');
            if (freeInput) { freeInput.disabled = true; freeInput.required = false; }
            if (hiddenInput) { hiddenInput.disabled = false; }
            if (nextInput && !nextInput.value) composePreview();
        } else {
            exp.min = '0.1'; exp.removeAttribute('max');
            hor.readOnly = false;
            if (hint) hint.textContent = '做T/趋势可按组合周期填写预期收益';
            freeWrap?.classList.remove('d-none');
            composerWrap?.classList.add('d-none');
            if (freeInput) { freeInput.disabled = false; freeInput.required = true; }
            if (hiddenInput) { hiddenInput.disabled = true; }
        }
    }

    exp?.addEventListener('input', () => { exp.dataset.touched = '1'; });
    document.querySelectorAll('input[name=tradeStyle]').forEach(r => r.addEventListener('change', sync));
    sectorEl?.addEventListener('change', composePreview);
    styleEl?.addEventListener('change', composePreview);
    catalystEl?.addEventListener('change', composePreview);

    document.querySelectorAll('.theme-chip').forEach(btn => {
        btn.addEventListener('click', () => {
            const t = btn.getAttribute('data-theme') || '';
            if (nextInput) nextInput.value = t;
            // 芯片直接写入预览；清空风格以免服务端 Compose 覆盖
            if (styleEl) styleEl.value = '';
            if (sectorEl) sectorEl.value = '';
        });
    });

    document.getElementById('goalForm')?.addEventListener('submit', () => {
        const next = document.getElementById('styleNextDay')?.checked;
        if (next && hiddenInput && nextInput) {
            hiddenInput.value = (nextInput.value || '').trim();
        }
    });

    sync();
})();
</script>

@if (goals.Count > 0)
{
    <h4>最近目标</h4>
    <div class="table-responsive mb-4">
        <table class="table table-sm table-hover">
            <thead>
            <tr>
                <th>创建</th>
                <th>目标</th>
                <th>状态</th>
                <th>最新达成率</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var g in goals.Take(5))
            {
                <tr>
                    <td>@g.CreationTime.ToLocalTime().ToString("MM-dd HH:mm")</td>
                    <td>@StockTradeStyleHelper.ToLabel(g.TradeStyle) · @g.ExpectedReturnPct% / @g.HorizonDays 天 · @g.ThemePreference</td>
                    <td>@g.Status</td>
                    <td>@(g.LatestAchievementRate.HasValue ? $"{g.LatestAchievementRate:N1}%" : "-")</td>
                    <td class="text-nowrap">
                        <a asp-action="GoalDetails" asp-route-id="@g.Id">详情</a>
                        <form asp-action="DeleteGoal" method="post" class="d-inline"
                              onsubmit="return confirm('确认删除该投资目标？');">
                            <input type="hidden" name="id" value="@g.Id" />
                            <button class="btn btn-sm btn-outline-danger ms-1">删除</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

<h4>选股任务历史</h4>
<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>时间</th>
            <th>类型</th>
            <th>状态</th>
            <th>提示词</th>
            <th>候选</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var j in Model.Items)
    {
        <tr>
            <td class="text-nowrap">@j.CreationTime.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
            <td>目标选股</td>
            <td><span class="badge bg-secondary">@j.Status</span></td>
            <td style="max-width:320px;"><div class="text-truncate" title="@j.Prompt">@j.Prompt</div></td>
            <td>@j.SuggestionCount</td>
            <td class="text-nowrap">
                <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@j.Id">查阅</a>
                @if (j.Status != AiJobStatus.Running)
                {
                    <form asp-action="DeleteJob" method="post" class="d-inline"
                          onsubmit="return confirm('确认删除该 AI 任务？');">
                        <input type="hidden" name="id" value="@j.Id" />
                        <button class="btn btn-sm btn-outline-danger">删除</button>
                    </form>
                }
            </td>
        </tr>
    }
    @if (Model.Items.Count == 0)
    {
        <tr><td colspan="6" class="text-muted text-center py-3">暂无选股任务</td></tr>
    }
    </tbody>
</table>
<partial name="_Pager" model="PagerModel.From(Model)" />
