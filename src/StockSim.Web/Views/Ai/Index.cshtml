@model IReadOnlyList<StockSim.Application.Dtos.AiJobDto>
@using StockSim.Domain.Enums
@using StockSim.Application.Services
@using StockSim.Application.Dtos
@{
    var cursorStatus = ViewBag.CursorStatus as CursorAiConnectionStatus;
    var goals = (IReadOnlyList<InvestmentGoalDto>)(ViewBag.Goals ?? Array.Empty<InvestmentGoalDto>());
}
<h2>AI 工作台</h2>
<p class="text-muted">输入<strong>预期收益、周期、题材偏好、选股类型</strong>（含次日上涨预选）→ 任务进入 <a asp-action="Queue">AI 队列</a> 异步执行 → 完成后勾选入库；每日跟踪达成率；次日预选在目标日收盘后统计命中率。</p>
@{
    var qc = ViewBag.QueueCounts as (int Pending, int Running, int Succeeded, int Failed)?;
}
@if (qc is not null)
{
    <div class="mb-3 small">
        队列：排队 @qc.Value.Pending · 执行中 @qc.Value.Running ·
        <a asp-action="Queue">查看 AI 队列</a>
    </div>
}
@if (cursorStatus is not null)
{
    <div class="alert @(cursorStatus.Ok ? "alert-success" : "alert-warning") py-2">
        <strong>Cursor Agent：</strong>
        @(cursorStatus.Ok ? "已接通" : "未接通")
        <span class="text-muted">(@cursorStatus.Status)</span>
        @if (!string.IsNullOrWhiteSpace(cursorStatus.Email))
        {
            <span>· @cursorStatus.Email</span>
        }
        <div class="small mt-1">@cursorStatus.Hint</div>
    </div>
}

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">按目标 AI 选股</h5>
        <form asp-action="CreateGoal" method="post" class="row g-3">
            <div class="col-md-3">
                <label class="form-label">预期收益 (%)</label>
                <input id="expectedReturnPct" name="expectedReturnPct" type="number" step="0.1" min="0.1" class="form-control" value="3" required />
                <div class="form-text" id="expectedHint">次日预涨将钳制为 0.5%～3%（默认 2%）</div>
            </div>
            <div class="col-md-3">
                <label class="form-label">预期周期（天）</label>
                <input id="horizonDays" name="horizonDays" type="number" min="1" class="form-control" value="10" required />
            </div>
            <div class="col-md-6">
                <label class="form-label">题材偏好</label>
                <input name="themePreference" class="form-control" placeholder="例如：新能源、低估值银行、高股息" required />
            </div>
            <div class="col-12">
                <label class="form-label d-block">选股类型</label>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="tradeStyle" id="styleT" value="IntradayT" checked />
                    <label class="form-check-label" for="styleT">做T股（日内高抛低吸）</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="tradeStyle" id="styleTrend" value="TrendSwing" />
                    <label class="form-check-label" for="styleTrend">趋势股（底部/中期趋势观察，不做自动做T）</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="tradeStyle" id="styleNextDay" value="NextDayRise" />
                    <label class="form-check-label" for="styleNextDay">次日上涨预选（方向+相对强弱为主 KPI）</label>
                </div>
            </div>
            <div class="col-12">
                <button class="btn btn-primary">提交选股任务（异步）</button>
                <a class="btn btn-outline-secondary" asp-action="Queue">AI 队列</a>
                <a class="btn btn-outline-secondary" asp-action="Goals">查看目标达成率</a>
            </div>
        </form>
        <form asp-action="EnqueueNextDayPickReviews" method="post" class="mt-2"
              onsubmit="return confirm('为近两周已结算的次日预涨标的入队复盘？');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-info btn-sm"
                    title="扫近两周池/目标已结算记录；结算后自动也会入队">复盘近批次日预涨</button>
        </form>
    </div>
</div>
<script>
(function () {
    const exp = document.getElementById('expectedReturnPct');
    const hor = document.getElementById('horizonDays');
    const hint = document.getElementById('expectedHint');
    function sync() {
        const next = document.getElementById('styleNextDay')?.checked;
        if (!exp || !hor) return;
        if (next) {
            exp.min = '0.5'; exp.max = '3'; exp.step = '0.1';
            if (parseFloat(exp.value) > 3) exp.value = '2';
            if (parseFloat(exp.value) < 0.5) exp.value = '2';
            if (!exp.dataset.touched) exp.value = '2';
            hor.value = '1'; hor.readOnly = true;
            if (hint) hint.textContent = '次日预涨：预期钳制 0.5%～3%，主看方向命中与相对强弱';
        } else {
            exp.min = '0.1'; exp.removeAttribute('max');
            hor.readOnly = false;
            if (hint) hint.textContent = '做T/趋势可按组合周期填写预期收益';
        }
    }
    exp?.addEventListener('input', () => { exp.dataset.touched = '1'; });
    document.querySelectorAll('input[name=tradeStyle]').forEach(r => r.addEventListener('change', sync));
    sync();
})();
</script>

@if (goals.Count > 0)
{
    <h4>最近目标</h4>
    <div class="table-responsive mb-4">
        <table class="table table-sm table-hover">
            <thead>
            <tr>
                <th>创建</th>
                <th>目标</th>
                <th>状态</th>
                <th>最新达成率</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var g in goals.Take(5))
            {
                <tr>
                    <td>@g.CreationTime.ToLocalTime().ToString("MM-dd HH:mm")</td>
                    <td>@StockTradeStyleHelper.ToLabel(g.TradeStyle) · @g.ExpectedReturnPct% / @g.HorizonDays 天 · @g.ThemePreference</td>
                    <td>@g.Status</td>
                    <td>@(g.LatestAchievementRate.HasValue ? $"{g.LatestAchievementRate:N1}%" : "-")</td>
                    <td class="text-nowrap">
                        <a asp-action="GoalDetails" asp-route-id="@g.Id">详情</a>
                        <form asp-action="DeleteGoal" method="post" class="d-inline"
                              onsubmit="return confirm('确认删除该投资目标？');">
                            <input type="hidden" name="id" value="@g.Id" />
                            <button class="btn btn-sm btn-outline-danger ms-1">删除</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

<h4>选股任务历史</h4>
<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>时间</th>
            <th>类型</th>
            <th>状态</th>
            <th>提示词</th>
            <th>候选</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var j in Model.Where(x => x.JobType == AiJobType.StockPick))
    {
        <tr>
            <td class="text-nowrap">@j.CreationTime.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
            <td>目标选股</td>
            <td><span class="badge bg-secondary">@j.Status</span></td>
            <td style="max-width:320px;"><div class="text-truncate" title="@j.Prompt">@j.Prompt</div></td>
            <td>@j.SuggestionCount</td>
            <td class="text-nowrap">
                <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@j.Id">查阅</a>
                @if (j.Status != AiJobStatus.Running)
                {
                    <form asp-action="DeleteJob" method="post" class="d-inline"
                          onsubmit="return confirm('确认删除该 AI 任务？');">
                        <input type="hidden" name="id" value="@j.Id" />
                        <button class="btn btn-sm btn-outline-danger">删除</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
