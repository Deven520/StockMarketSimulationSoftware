@model StockSim.Application.Dtos.AiJobDetailDto
@using StockSim.Domain.Enums
@using StockSim.Application.Dtos
@{
    Guid? goalId = ViewBag.GoalId as Guid?;
    var goalDetail = ViewBag.Goal as InvestmentGoalDetailDto;
    var statusClass = Model.Status switch
    {
        AiJobStatus.Accepted => "success",
        AiJobStatus.Rejected => "secondary",
        AiJobStatus.Failed => "danger",
        AiJobStatus.SucceededPendingReview => "warning",
        _ => "secondary"
    };
}
<div class="mb-3 d-flex justify-content-between align-items-start flex-wrap gap-2">
    <div>
        <h2 class="mb-1">AI 选股查阅</h2>
        <span class="badge bg-@statusClass">@Model.Status</span>
        <span class="text-muted small ms-2">@Model.CreationTime.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
    </div>
    <div>
        <a class="btn btn-outline-secondary btn-sm" asp-action="Index">返回工作台</a>
        @if (goalId.HasValue)
        {
            <a class="btn btn-outline-primary btn-sm" asp-action="GoalDetails" asp-route-id="@goalId">查看目标</a>
        }
    </div>
</div>

@if (goalDetail is not null)
{
    <div class="alert alert-light border">
        <strong>投资目标：</strong>
        @(goalDetail.Goal.TradeStyle == StockSim.Domain.Enums.StockTradeStyle.TrendSwing ? "趋势股" : "做T股") /
        预期 @goalDetail.Goal.ExpectedReturnPct% /
        @goalDetail.Goal.HorizonDays 天 /
        题材「@goalDetail.Goal.ThemePreference」
        · 状态 @goalDetail.Goal.Status
        @if (!string.IsNullOrWhiteSpace(goalDetail.Goal.PromptRationale))
        {
            <div class="small text-muted mt-1">@goalDetail.Goal.PromptRationale</div>
        }
    </div>
}

@if (Model.Status == AiJobStatus.Failed && !string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div class="card mb-3">
    <div class="card-header">选股提示词（由目标生成）</div>
    <div class="card-body"><pre class="mb-0" style="white-space:pre-wrap;">@Model.Prompt</pre></div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.AnalysisSummary))
{
    <div class="card mb-3">
        <div class="card-header bg-success text-white">分析说明</div>
        <div class="card-body"><pre class="mb-0" style="white-space:pre-wrap;">@Model.AnalysisSummary</pre></div>
    </div>
}

@if (Model.AnalysisSteps.Count > 0)
{
    <ol class="mb-3">
        @foreach (var step in Model.AnalysisSteps)
        {
            <li>@step</li>
        }
    </ol>
}

<h4 class="mb-3">候选股票（@Model.Suggestions.Count）</h4>

@if (goalId.HasValue && Model.Status == AiJobStatus.SucceededPendingReview && Model.Suggestions.Any(s => !s.ReviewedAt.HasValue))
{
    <form asp-action="AcceptGoalPicks" method="post" class="mb-3">
        <input type="hidden" name="goalId" value="@goalId" />
        <input type="hidden" name="jobId" value="@Model.Id" />
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle">
                <thead>
                <tr>
                    <th style="width:40px;">选</th>
                    <th>代码</th>
                    <th>名称</th>
                    <th>理由</th>
                    <th>选取逻辑</th>
                    <th>风险</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var s in Model.Suggestions)
                {
                    var logic = !string.IsNullOrWhiteSpace(s.SelectionLogic) ? s.SelectionLogic : s.Reason;
                    <tr>
                        <td>
                            @if (!s.ReviewedAt.HasValue)
                            {
                                <input type="checkbox" name="suggestionIds" value="@s.Id" class="form-check-input" checked />
                            }
                        </td>
                        <td>@s.Symbol</td>
                        <td>@s.Name</td>
                        <td class="small">@s.Reason</td>
                        <td class="small" style="white-space:pre-wrap;max-width:28rem;">@logic</td>
                        <td class="small text-muted">@s.Risk</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <button class="btn btn-success">确认选中股票入库并开始跟踪达成率</button>
    </form>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-hover">
            <thead>
            <tr><th>代码</th><th>名称</th><th>理由</th><th>选取逻辑</th><th>风险</th><th>状态</th></tr>
            </thead>
            <tbody>
            @foreach (var s in Model.Suggestions)
            {
                var logic = !string.IsNullOrWhiteSpace(s.SelectionLogic) ? s.SelectionLogic : s.Reason;
                <tr>
                    <td>@s.Symbol</td>
                    <td>@s.Name</td>
                    <td class="small">@s.Reason</td>
                    <td class="small" style="white-space:pre-wrap;max-width:28rem;">@logic</td>
                    <td class="small text-muted">@s.Risk</td>
                    <td>@(s.IsAccepted ? "已入选" : (s.ReviewedAt.HasValue ? "已处理" : "待审"))</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
