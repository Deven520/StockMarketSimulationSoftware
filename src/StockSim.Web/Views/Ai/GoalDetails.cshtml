@model StockSim.Application.Dtos.InvestmentGoalDetailDto
@{
    var g = Model.Goal;
}
<div class="mb-3 d-flex justify-content-between align-items-start flex-wrap gap-2">
    <div>
        <h2 class="mb-1">目标详情</h2>
        <div class="text-muted">@StockSim.Domain.Enums.StockTradeStyleHelper.ToLabel(g.TradeStyle) · @g.ThemePreference · 预期 @g.ExpectedReturnPct% / @g.HorizonDays 天 · @g.Status</div>
    </div>
    <div class="d-flex gap-2">
        <form asp-action="RefreshGoalProgress" method="post" class="d-inline">
            <input type="hidden" name="id" value="@g.Id" />
            <button class="btn btn-outline-primary btn-sm">刷新今日达成率</button>
        </form>
        @if (g.TradeStyle == StockSim.Domain.Enums.StockTradeStyle.NextDayRise)
        {
            <form asp-action="EnqueueNextDayPickReviews" method="post" class="d-inline"
                  onsubmit="return confirm('为已对账入选股入队次日预涨复盘？');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="goalId" value="@g.Id" />
                <button class="btn btn-outline-info btn-sm" title="对账后 AI 错因分析，供下一批选股注入">入队选股复盘</button>
            </form>
        }
        <a class="btn btn-outline-secondary btn-sm" asp-action="Goals">返回列表</a>
        @if (g.StockPickJobId.HasValue)
        {
            <a class="btn btn-outline-secondary btn-sm" asp-action="Details" asp-route-id="@g.StockPickJobId" asp-route-goalId="@g.Id">选股任务</a>
        }
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="border rounded p-3">
            <div class="text-muted small">最新达成率</div>
            <div class="fs-4">@(g.LatestAchievementRate?.ToString("N1") ?? "-")%</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="border rounded p-3">
            <div class="text-muted small">组合收益</div>
            <div class="fs-4">@(g.LatestPortfolioReturnPct?.ToString("N2") ?? "-")%</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="border rounded p-3">
            <div class="text-muted small">起止</div>
            <div>@(g.StartDate?.ToString("yyyy-MM-dd") ?? "-") ~ @(g.TargetEndDate?.ToString("yyyy-MM-dd") ?? "-")</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="border rounded p-3">
            <div class="text-muted small">入选股票</div>
            <div class="fs-4">@g.StockCount</div>
        </div>
    </div>
    @if (g.TradeStyle == StockSim.Domain.Enums.StockTradeStyle.NextDayRise)
    {
        <div class="col-md-3">
            <div class="border rounded p-3">
                <div class="text-muted small">方向命中率（主KPI）</div>
                <div class="fs-4">@(g.DirectionHitRatePct?.ToString("N1") ?? "-")%</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="border rounded p-3">
                <div class="text-muted small">平均相对强弱%</div>
                <div class="fs-4">@(g.AvgRelativeStrengthPct?.ToString("N2") ?? "-")</div>
                <div class="text-muted small">个股−创业板指</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="border rounded p-3">
                <div class="text-muted small">等权次日收益%</div>
                <div class="fs-4">@(g.AvgNextDayReturnPct?.ToString("N2") ?? "-")</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="border rounded p-3">
                <div class="text-muted small">弹性目标命中率</div>
                <div class="fs-4">@(g.TargetHitRatePct?.ToString("N1") ?? "-")%</div>
                <div class="text-muted small">预期 @g.ExpectedReturnPct%（≤3% 钳制）</div>
            </div>
        </div>
    }
</div>

@if (!string.IsNullOrWhiteSpace(g.GeneratedPrompt))
{
    <div class="card mb-3">
        <div class="card-header">AI 生成的选股提示词</div>
        <div class="card-body"><pre class="mb-0 small" style="white-space:pre-wrap;">@g.GeneratedPrompt</pre></div>
    </div>
}

<h5>入选股票</h5>
<table class="table table-sm mb-4">
    <thead>
    <tr>
        <th>代码</th>
        <th>名称</th>
        <th>基准资金</th>
        @if (g.TradeStyle == StockSim.Domain.Enums.StockTradeStyle.NextDayRise)
        {
            <th>基准价</th>
            <th>目标日</th>
            <th>收盘</th>
            <th>次日收益%</th>
            <th>方向</th>
            <th>目标</th>
        }
        <th>选取逻辑</th>
        <th>风险</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var s in Model.Stocks)
    {
        var logic = !string.IsNullOrWhiteSpace(s.SelectionLogic) ? s.SelectionLogic : s.Reason;
        <tr>
            <td>@s.Symbol</td>
            <td>@s.Name</td>
            <td>@s.BaselineCash.ToString("N0")</td>
            @if (g.TradeStyle == StockSim.Domain.Enums.StockTradeStyle.NextDayRise)
            {
                <td>@(s.BaselinePrice?.ToString("N2") ?? "-")</td>
                <td>@(s.TargetTradeDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                <td>@(s.ActualClose?.ToString("N2") ?? "-")</td>
                <td class="@(s.NextDayReturnPct is null ? "" : (s.NextDayReturnPct >= 0 ? "text-danger" : "text-success"))">
                    @(s.NextDayReturnPct?.ToString("N2") ?? "-")
                </td>
                <td>@(s.DirectionHit is null ? "-" : (s.DirectionHit.Value ? "命中" : "未中"))</td>
                <td>@(s.TargetHit is null ? "-" : (s.TargetHit.Value ? "命中" : "未中"))</td>
            }
            <td class="small" style="white-space:pre-wrap;max-width:28rem;">@(logic ?? "—")</td>
            <td class="small text-muted">@(s.Risk ?? "—")</td>
        </tr>
    }
    @if (Model.Stocks.Count == 0)
    {
        <tr><td colspan="11" class="text-muted">尚未确认入选</td></tr>
    }
    </tbody>
</table>

@if (g.TradeStyle == StockSim.Domain.Enums.StockTradeStyle.NextDayRise)
{
    <h5>次日预涨复盘</h5>
    @if (Model.NextDayPickReviews is not { Count: > 0 })
    {
        <p class="text-muted small">暂无复盘。对账完成后可点「入队选股复盘」，或等日终结算自动入队。</p>
    }
    else
    {
        <div class="table-responsive mb-4">
            <table class="table table-sm table-hover">
                <thead>
                <tr>
                    <th>目标日</th>
                    <th>代码</th>
                    <th>名称</th>
                    <th>评级</th>
                    <th>收益%</th>
                    <th>方向</th>
                    <th>相对强弱</th>
                    <th>错因</th>
                    <th>摘要</th>
                    <th>状态</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var r in Model.NextDayPickReviews!)
                {
                    <tr>
                        <td>@r.TargetTradeDate.ToString("yyyy-MM-dd")</td>
                        <td>@r.Symbol</td>
                        <td>@r.Name</td>
                        <td>@(r.Grade ?? "-")</td>
                        <td class="@(r.ReturnPct is null ? "" : (r.ReturnPct >= 0 ? "text-danger" : "text-success"))">
                            @(r.ReturnPct?.ToString("N2") ?? "-")
                        </td>
                        <td>@(r.DirectionHit is null ? "-" : (r.DirectionHit.Value ? "命中" : "未中"))</td>
                        <td>@(r.RelativeStrengthPct?.ToString("N2") ?? "-")</td>
                        <td class="small">@(r.FailureTagsJson ?? "—")</td>
                        <td class="small" style="white-space:pre-wrap;max-width:22rem;">@(r.Summary ?? "—")</td>
                        <td>@r.Status</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
}

<h5>每日达成率</h5>
<table class="table table-sm table-hover">
    <thead>
    <tr>
        <th>日期</th>
        <th>天数</th>
        <th>组合收益%</th>
        <th>达成率%</th>
        <th>市值合计</th>
        <th>已实现</th>
        <th>浮动</th>
        <th>备注</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var p in Model.Progress.OrderByDescending(x => x.TradeDate))
    {
        <tr>
            <td>@p.TradeDate.ToString("yyyy-MM-dd")</td>
            <td>@p.DayIndex</td>
            <td>@p.PortfolioReturnPct.ToString("N2")</td>
            <td>@p.AchievementRate.ToString("N1")</td>
            <td>@p.TotalMarketValue.ToString("N0")</td>
            <td>@p.RealizedPnL.ToString("N2")</td>
            <td>@p.UnrealizedPnL.ToString("N2")</td>
            <td class="small text-muted">@p.Notes</td>
        </tr>
    }
    @if (Model.Progress.Count == 0)
    {
        <tr><td colspan="8" class="text-muted text-center py-3">暂无进度（确认入选后开始记录）</td></tr>
    }
    </tbody>
</table>
