@model IReadOnlyList<StockSim.Application.Dtos.AiQueueItemDto>
@using StockSim.Domain.Enums
@{
    var counts = ((int Pending, int Running, int Succeeded, int Failed)?)ViewBag.Counts;
    var filter = ViewBag.FilterStatus as string;
    var highlight = ViewBag.Highlight as Guid?;
    string StatusBadge(AiQueueItemStatus s) => s switch
    {
        AiQueueItemStatus.Pending => "secondary",
        AiQueueItemStatus.Running => "primary",
        AiQueueItemStatus.Succeeded => "success",
        AiQueueItemStatus.Failed => "danger",
        _ => "dark"
    };
    string TypeName(AiQueueTaskType t) => t switch
    {
        AiQueueTaskType.GoalToPrompt => "目标→提示词",
        AiQueueTaskType.StockPick => "选股",
        AiQueueTaskType.StrategyRefresh => "策略刷新",
        _ => t.ToString()
    };
    string StatusName(AiQueueItemStatus s) => s switch
    {
        AiQueueItemStatus.Pending => "排队中",
        AiQueueItemStatus.Running => "执行中",
        AiQueueItemStatus.Succeeded => "成功",
        AiQueueItemStatus.Failed => "失败",
        _ => s.ToString()
    };
}
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h2 class="mb-1">AI 队列</h2>
        <div class="text-muted small">所有 AI 操作异步排队执行；本页可查看进度、入参与返回结果。</div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary btn-sm" asp-action="Index">AI 工作台</a>
        <a class="btn btn-outline-primary btn-sm" href="?">全部</a>
    </div>
</div>

@if (counts is not null)
{
    var c = counts.Value;
    <div class="row g-2 mb-3">
        <div class="col-6 col-md-3"><div class="border rounded p-2"><div class="small text-muted">排队中</div><div class="fs-4">@c.Pending</div></div></div>
        <div class="col-6 col-md-3"><div class="border rounded p-2"><div class="small text-muted">执行中</div><div class="fs-4 text-primary">@c.Running</div></div></div>
        <div class="col-6 col-md-3"><div class="border rounded p-2"><div class="small text-muted">成功</div><div class="fs-4 text-success">@c.Succeeded</div></div></div>
        <div class="col-6 col-md-3"><div class="border rounded p-2"><div class="small text-muted">失败</div><div class="fs-4 text-danger">@c.Failed</div></div></div>
    </div>
}

<div class="mb-2">
    <a class="btn btn-sm @(filter==null?"btn-dark":"btn-outline-dark")" href="?">全部</a>
    <a class="btn btn-sm @(filter=="Pending"?"btn-secondary":"btn-outline-secondary")" href="?status=Pending">排队中</a>
    <a class="btn btn-sm @(filter=="Running"?"btn-primary":"btn-outline-primary")" href="?status=Running">执行中</a>
    <a class="btn btn-sm @(filter=="Succeeded"?"btn-success":"btn-outline-success")" href="?status=Succeeded">成功</a>
    <a class="btn btn-sm @(filter=="Failed"?"btn-danger":"btn-outline-danger")" href="?status=Failed">失败</a>
</div>

<div class="table-responsive">
    <table class="table table-sm table-hover align-middle">
        <thead class="table-light">
        <tr>
            <th>状态</th>
            <th>类型</th>
            <th>标题</th>
            <th>标的</th>
            <th>入队</th>
            <th>开始</th>
            <th>结束</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var x in Model)
        {
            var rowClass = highlight == x.Id ? "table-warning" : "";
            <tr class="@rowClass">
                <td><span class="badge bg-@StatusBadge(x.Status)">@StatusName(x.Status)</span></td>
                <td class="small">@TypeName(x.TaskType)</td>
                <td>@x.Title</td>
                <td>@(x.Symbol ?? "—")</td>
                <td class="small text-muted">@x.CreationTime.ToLocalTime().ToString("MM-dd HH:mm:ss")</td>
                <td class="small text-muted">@(x.StartedAt?.ToLocalTime().ToString("HH:mm:ss") ?? "—")</td>
                <td class="small text-muted">@(x.CompletedAt?.ToLocalTime().ToString("HH:mm:ss") ?? "—")</td>
                <td>
                    <a class="btn btn-sm btn-outline-secondary" asp-action="QueueDetails" asp-route-id="@x.Id">详情</a>
                    @if (x.RelatedAiJobId.HasValue && x.Status == AiQueueItemStatus.Succeeded && x.TaskType == AiQueueTaskType.StockPick)
                    {
                        <a class="btn btn-sm btn-outline-success" asp-action="Details" asp-route-id="@x.RelatedAiJobId" asp-route-goalId="@x.RelatedGoalId">选股结果</a>
                    }
                </td>
            </tr>
            @if (!string.IsNullOrWhiteSpace(x.ErrorMessage))
            {
                <tr class="@rowClass"><td colspan="8" class="small text-danger py-1">@x.ErrorMessage</td></tr>
            }
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="8" class="text-muted text-center py-4">暂无队列记录</td></tr>
        }
        </tbody>
    </table>
</div>

<p class="small text-muted">页面每 8 秒自动刷新（执行中/排队中时便于观察进度）。</p>

@section Scripts {
<script>
(() => {
  const hasActive = @((Model.Any(x => x.Status is AiQueueItemStatus.Pending or AiQueueItemStatus.Running)).ToString().ToLowerInvariant());
  if (hasActive) setTimeout(() => location.reload(), 8000);
})();
</script>
}
