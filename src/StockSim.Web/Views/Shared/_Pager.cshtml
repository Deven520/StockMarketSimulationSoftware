@model StockSim.Web.Models.PagerModel
@{
    if (Model.TotalCount <= 0)
    {
        return;
    }

    var req = Context.Request;
    var sizes = new[] { 10, 20, 50, 100 };
    string Link(int p, int? pageSize = null)
    {
        var size = pageSize ?? Model.PageSize;
        var q = new List<string>();
        foreach (var kv in req.Query)
        {
            if (string.Equals(kv.Key, Model.PageParam, StringComparison.OrdinalIgnoreCase)
                || string.Equals(kv.Key, "pageSize", StringComparison.OrdinalIgnoreCase))
                continue;
            foreach (var v in kv.Value)
            {
                if (v is null) continue;
                q.Add($"{Uri.EscapeDataString(kv.Key)}={Uri.EscapeDataString(v)}");
            }
        }
        q.Add($"{Uri.EscapeDataString(Model.PageParam)}={p}");
        q.Add($"pageSize={size}");
        var qs = string.Join("&", q);
        var path = req.Path.HasValue ? req.Path.Value! : "";
        var url = string.IsNullOrEmpty(qs) ? path : $"{path}?{qs}";
        if (!string.IsNullOrWhiteSpace(Model.Anchor))
            url += "#" + Model.Anchor;
        return url;
    }

    // 页码窗口：当前页前后各 2
    var start = Math.Max(1, Model.Page - 2);
    var end = Math.Min(Model.TotalPages, Model.Page + 2);
    if (end - start < 4)
    {
        start = Math.Max(1, end - 4);
        end = Math.Min(Model.TotalPages, start + 4);
    }

    var sizeSelectId = "pageSizeSelect_" + Guid.NewGuid().ToString("N")[..8];
}
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 my-2">
    <div class="d-flex align-items-center flex-wrap gap-2 small text-muted">
        <span>共 @Model.TotalCount 条 · 第 @Model.Page / @Model.TotalPages 页</span>
        <label class="mb-0 d-inline-flex align-items-center gap-1" for="@sizeSelectId">
            每页
            <select id="@sizeSelectId" class="form-select form-select-sm d-inline-block js-page-size" style="width:auto;min-width:4.5rem;"
                    data-page-param="@Model.PageParam"
                    data-anchor="@(Model.Anchor ?? "")">
                @foreach (var s in sizes)
                {
                    if (s == Model.PageSize)
                    {
                        <option value="@s" selected>@s</option>
                    }
                    else
                    {
                        <option value="@s">@s</option>
                    }
                }
            </select>
            条
        </label>
    </div>
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="分页">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.HasPrev ? "" : "disabled")">
                    @if (Model.HasPrev)
                    {
                        <a class="page-link" href="@Link(Model.Page - 1)">上一页</a>
                    }
                    else
                    {
                        <span class="page-link">上一页</span>
                    }
                </li>
                @if (start > 1)
                {
                    <li class="page-item"><a class="page-link" href="@Link(1)">1</a></li>
                    if (start > 2)
                    {
                        <li class="page-item disabled"><span class="page-link">…</span></li>
                    }
                }
                @for (var i = start; i <= end; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link" href="@Link(i)">@i</a>
                    </li>
                }
                @if (end < Model.TotalPages)
                {
                    if (end < Model.TotalPages - 1)
                    {
                        <li class="page-item disabled"><span class="page-link">…</span></li>
                    }
                    <li class="page-item"><a class="page-link" href="@Link(Model.TotalPages)">@Model.TotalPages</a></li>
                }
                <li class="page-item @(Model.HasNext ? "" : "disabled")">
                    @if (Model.HasNext)
                    {
                        <a class="page-link" href="@Link(Model.Page + 1)">下一页</a>
                    }
                    else
                    {
                        <span class="page-link">下一页</span>
                    }
                </li>
            </ul>
        </nav>
    }
</div>
<script>
(function () {
    var sel = document.getElementById('@sizeSelectId');
    if (!sel || sel.dataset.bound === '1') return;
    sel.dataset.bound = '1';
    sel.addEventListener('change', function () {
        var size = parseInt(sel.value, 10) || 20;
        var pageParam = sel.getAttribute('data-page-param') || 'page';
        var anchor = sel.getAttribute('data-anchor') || '';
        var url = new URL(window.location.href);
        url.searchParams.set(pageParam, '1');
        url.searchParams.set('pageSize', String(size));
        var href = url.pathname + url.search + (anchor ? ('#' + anchor) : '');
        window.location.href = href;
    });
})();
</script>
